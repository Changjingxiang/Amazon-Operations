{
  "manifest_version": 3,
  "name": "关键词 AI 安全连接",
  "version": "2.1.0",
  "description": "在关键词排名网页版使用本机 AI 连接器；不读取或保存 API 密钥。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "关键词 AI 安全连接",
    "default_popup": "popup.html"
  }
}