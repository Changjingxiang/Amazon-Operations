{
  "name": "keyword-rank-daily-tracker",
  "version": "3.0.3",
  "private": true,
  "description": "关键词排名每日跟进桌面软件",
  "main": "electron/main.cjs",
  "scripts": {
    "data:dev": "node scripts/export-dev-data.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "build:ai": "node scripts/build-ai.cjs",
    "start:ai": "electron electron/ai/main.cjs",
    "test:ai": "node --test tests/ai/*.test.*",
    "dist:ai": "npm run build:ai && electron-builder --config electron/ai/builder.cjs --win portable --x64",
    "dist:connector": "node scripts/build-native-relay.cjs && electron-builder --config electron/ai/connector-builder.cjs --win --x64 --dir"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "ipaddr.js": "2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.62.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.keywordrank.dailytracker",
    "productName": "关键词排名每日跟进",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bridge",
        "to": "bridge"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "关键词排名每日跟进软件-${version}-portable.${ext}"
    }
  }
}
