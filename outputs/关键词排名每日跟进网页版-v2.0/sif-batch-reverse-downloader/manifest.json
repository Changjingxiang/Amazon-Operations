{
  "manifest_version": 3,
  "name": "Sif ASIN 批量反查下载器",
  "version": "1.1.2",
  "description": "为关键词排名网页版按各站点批量反查 ASIN，自动下载并回传父体流量词报表。",
  "permissions": [
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.sif.com/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Sif 批量反查",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sif.com/reverse*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
