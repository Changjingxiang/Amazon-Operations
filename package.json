{
  "name": "amazon-operations",
  "version": "3.0.2",
  "private": true,
  "description": "Amazon Operations tools and keyword-rank web application",
  "scripts": {
    "install:keyword-rank": "npm --prefix apps/keyword-rank install",
    "postinstall": "npm run install:keyword-rank",
    "dev": "npm --prefix apps/keyword-rank run dev",
    "build": "npm --prefix apps/keyword-rank run build",
    "dist:win": "npm --prefix apps/keyword-rank run dist:win",
    "release:web": "node tools/release-web.cjs",
    "verify:web": "node tools/verify-web-release.cjs",
    "build:ai": "npm --prefix apps/keyword-rank run build:ai",
    "test:ai": "npm --prefix apps/keyword-rank run test:ai",
    "dist:ai": "npm --prefix apps/keyword-rank run dist:ai",
    "dist:connector": "npm --prefix apps/keyword-rank run dist:connector",
    "release:web-ai": "node tools/package-web-ai.cjs"
  }
}
